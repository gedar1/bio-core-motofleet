PORT=3000
JWT_SECRET=change-me-in-production
DB_PATH=./data/motofleet.db
# Private, absolute server-side repository. It must not be inside public or frontend/dist.
CONTRACT_DOCUMENTS_DIR=/var/lib/motofleet/contract-documents
# Optional repository quota; omit to rely on volume capacity.
CONTRACT_DOCUMENTS_MAX_BYTES=1073741824
# Keep this free on the volume and reserve this extra amount per upload.
CONTRACT_DOCUMENTS_MIN_AVAILABLE_BYTES=52428800
CONTRACT_DOCUMENTS_TEMPORARY_MARGIN_BYTES=26214400
# Increasing percentage thresholds used by the capacity monitor.
CONTRACT_DOCUMENTS_CAPACITY_THRESHOLDS=70,85,95
# Comma-separated frontend origins permitted to call the API from browsers.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Temporary guard and password for a one-time, idempotent demo seed.
# Set only in Railway when intentionally executing `npm run seed:demo`.
DEMO_SEED_CONFIRM=motofleet-demo-v1
DEMO_SEED_PASSWORD=ChangeMe123

# Disabled by default to prevent email noise during deployments and testing.
# Set to true only when email delivery is intentionally enabled.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@motofleet.com

# Mapbox Directions token (server-only; never prefix with VITE_).
# Keep this token in the backend environment only and do not commit a real value.
# Mapbox Directions accepts a valid access token; use a dedicated server token.
MAPBOX_SECRET_TOKEN=pk.your-server-only-token

# Contract document provider. Keep filesystem during migration; switch to s3 only after verification.
CONTRACT_STORAGE_PROVIDER=filesystem
# S3-compatible provider settings (required only when CONTRACT_STORAGE_PROVIDER=s3).
CONTRACT_S3_BUCKET=motofleet-contract-documents
CONTRACT_S3_REGION=us-east-1
CONTRACT_S3_ENDPOINT=
CONTRACT_S3_ACCESS_KEY_ID=
CONTRACT_S3_SECRET_ACCESS_KEY=
CONTRACT_S3_SESSION_TOKEN=
CONTRACT_S3_FORCE_PATH_STYLE=false
CONTRACT_S3_PREFIX=motofleet/contracts
# Set only for the separate migration command after operational approval.
CONTRACT_STORAGE_MIGRATION_ACTIVATE=false
