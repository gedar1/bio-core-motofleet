{
  "info": {
    "name": "MotoFleet MVP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for MotoFleet MVP backend testing"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userToken", "value": "" },
    { "key": "riderToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "riderId", "value": "" },
    { "key": "motorcycleId", "value": "" },
    { "key": "contractId", "value": "" },
    { "key": "errandId", "value": "" },
    { "key": "pricingRuleId", "value": "" },
    { "key": "cosignerId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"German Arbelaez\",\n  \"phone\": \"3001234567\",\n  \"email\": \"german@test.com\",\n  \"address\": \"Calle 10 #20-30 Medellin\",\n  \"password\": \"Test1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('userId', res.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Rider",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/riders/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Rider\",\n  \"phone\": \"3109876543\",\n  \"email\": \"carlos@rider.com\",\n  \"address\": \"Carrera 50 #30-10\",\n  \"password\": \"Rider1234\",\n  \"license_number\": \"LIC-12345\",\n  \"license_expiry\": \"2027-12-31\",\n  \"insurance_number\": \"SEG-99999\",\n  \"insurance_expiry\": \"2027-06-30\",\n  \"bond_amount\": 500000,\n  \"emergency_contact_name\": \"Maria Rider\",\n  \"emergency_contact_phone\": \"3201112233\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('riderId', res.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"german@test.com\",\n  \"password\": \"Test1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('userToken', res.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Rider",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@rider.com\",\n  \"password\": \"Rider1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('riderToken', res.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@motofleet.com\",\n  \"password\": \"Admin1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('adminToken', res.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Invalid Credentials",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noexiste@test.com\",\n  \"password\": \"wrong123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Motorcycles (Admin)",
      "item": [
        {
          "name": "Create Motorcycle",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/motorcycles",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"ABC123\",\n  \"brand\": \"Yamaha\",\n  \"model\": \"FZ25\",\n  \"year\": 2024,\n  \"color\": \"Negro\",\n  \"engine_cc\": 250,\n  \"soat_expiry\": \"2027-03-15\",\n  \"inspection_expiry\": \"2027-06-20\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('motorcycleId', res.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Motorcycles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motorcycles",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Update Motorcycle",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/motorcycles/{{motorcycleId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color\": \"Rojo\",\n  \"engine_cc\": 300\n}"
            }
          }
        },
        {
          "name": "Change Status to Maintenance",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/motorcycles/{{motorcycleId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Cosigners (Admin)",
