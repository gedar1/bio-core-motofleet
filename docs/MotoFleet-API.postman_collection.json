    {
      "name": "Authorization Tests",
      "item": [
        {
          "name": "User tries Admin endpoint (403)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motorcycles",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ]
          }
        },
        {
          "name": "No token (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motorcycles"
          }
        },
        {
          "name": "Rider tries Admin endpoint (403)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/motorcycles",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{riderToken}}" }
