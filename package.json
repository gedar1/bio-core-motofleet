{
  "name": "bio-core-motofleet",
  "version": "1.0.0",
  "description": "MotoFleet MVP — Motorcycle fleet rental and errand marketplace",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "verify:migration:14.7": "node scripts/verify-route-migration.mjs",
    "storage:migrate:s3": "node --import tsx src/scripts/migrate-contract-documents-to-s3.ts",
    "seed:demo": "node dist/scripts/seed-demo.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.750.0",
    "@mapbox/mapbox-sdk": "0.16.2",
    "bcrypt": "5.1.1",
    "better-sqlite3": "11.7.0",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "pdf-lib": "1.17.1",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "uuid": "11.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "fast-check": "3.23.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
