# Token público Mapbox (pk.*). Restrínjalo por URL/origen y permisos mínimos.
# VITE_ es visible en el bundle: nunca coloque aquí un token secreto ni credenciales de pago.
VITE_MAPBOX_PUBLIC_TOKEN=pk.your-restricted-public-token

# URL pública de la API, incluido el prefijo /api. En desarrollo se puede omitir
# para usar el proxy de Vite configurado en vite.config.ts.
VITE_API_BASE_URL=https://your-api.up.railway.app/api
